# Copy to .env for local development (docker-compose reads this file too).

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://model_portfolio:model_portfolio@localhost:5432/model_portfolio?schema=public"

# HTTP port the API listens on.
PORT=4000

# Secret used to sign JWTs. Generate a real one for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="12h"

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
